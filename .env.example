# ==========================================
# Algomatic Web App - Environment Configuration
# ==========================================

# Base Backend API URL
# Production:  https://api.algomaticbot.com/api/v1/
# Development: http://localhost:3002/api/v1/
NEXT_PUBLIC_BACKEND_URL=https://api.algomaticbot.com/api/v1/

# Frontend Web App URL
# Production:  https://algomaticbot.com
# Development: http://localhost:4000
NEXT_PUBLIC_APP_URL=https://algomaticbot.com

# Remote Config Server (Optional: used with 'npm run env:pull')
# CONFIG_SERVER_URL=
# CONFIG_SECRET=
